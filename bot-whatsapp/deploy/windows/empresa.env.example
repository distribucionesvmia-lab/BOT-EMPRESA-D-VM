# Aplicación de la EMPRESA (solo para ti: escucha únicamente dentro del servidor). Copia a C:\vm\config\empresa.env y rellénalo.
APP_MODE=empresa
PORT=3001
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3001
# Tu clave de administrador: larga, aleatoria y secreta
ADMIN_TOKEN=CAMBIA-ESTO-POR-UNA-CLAVE-LARGA
LINK_SECRET=LA-MISMA-QUE-EN-cliente.env
NIF_PEPPER=LA-MISMA-QUE-EN-cliente.env
DB_PATH=C:\vm\datos\pedidos.sqlite
CATALOG_DB=C:\vm\datos\catalogo.sqlite
CUSTOMERS_DB=C:\vm\datos\clientes.sqlite
ACCOUNTS_DB=C:\vm\datos\cuentas.sqlite
IMG_DIR=C:\vm\datos\imagenes\
EXPORT_DIR=C:\vm\datos\exportaciones
# Copias diarias de todas las bases: ponlo en una carpeta que sincronice Google Drive para escritorio
BACKUP_DIR=C:\vm\datos\respaldos
BACKUP_TIME=03:00
# Bandeja de entrada: carpeta del ordenador donde se dejan los Excel de a3ERP (clientes, artículos, historial) y el ZIP de fotos.
# El panel los enseña en «Datos y Excel»; nada se aplica solo: «Ver cambios» y «Aplicar cambios». Los aplicados pasan a la subcarpeta «aplicados». Usa una ruta SIN tildes.
ENTRADA_DIR=C:\vm\entrada
# Sincronización con la carpeta «datos» de Google Drive (ver docs/GOOGLE_DRIVE.md)
DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=C:\vm\config\google.json
SYNC_MINUTES=15
# Aviso por correo de cada pedido (IONOS). Déjalo igual en cliente.env y empresa.env. Sin SMTP_HOST y MAIL_TO no se envía nada.
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
