# Exportación automática de a3ERP a la carpeta de Drive. Copia a C:\vm\config\a3erp.env y rellénalo.
# Servidor e instancia de SQL Server donde está a3ERP (en las copias aparece como SRVVALENTIN\A3ERP)
A3_SQL_SERVER=SRVVALENTIN\A3ERP
# Base de datos de la empresa
A3_DB=VALENTIN
# Déjalos vacíos para entrar con la cuenta de Windows de este PC. Si no, un usuario de SQL Server con permiso SOLO de lectura (ver docs/GOOGLE_DRIVE.md)
A3_SQL_USER=
A3_SQL_PASS=
# Carpeta de Google Drive para escritorio donde la web lee los Excel
CARPETA_DATOS="G:\Mi unidad\DISTRIBUCIONES VM DATOS"
# Meses de historial de ventas que se envían
MESES_HISTORIAL=12
