# Aplicación del CLIENTE (la que se publica en internet). Copia este fichero a C:\vm\config\cliente.env y rellénalo.
APP_MODE=cliente
PORT=3000
# Dirección pública https (la que te dé Tailscale Funnel o Cloudflare Tunnel)
PUBLIC_URL=https://TU-DIRECCION-PUBLICA
TRUST_PROXY=1
# Cadena larga y aleatoria (secreta). Firma los enlaces del pedido.
LINK_SECRET=CAMBIA-ESTO-POR-ALGO-LARGO-Y-ALEATORIO
# Secreto de las huellas del NIF: DEBE ser igual en cliente.env y empresa.env y NO cambiarse nunca después
NIF_PEPPER=CAMBIA-ESTO-POR-OTRA-CADENA-LARGA-Y-FIJA
# Datos (la misma carpeta que en empresa.env)
DB_PATH=C:\vm\datos\pedidos.sqlite
CATALOG_DB=C:\vm\datos\catalogo.sqlite
CUSTOMERS_DB=C:\vm\datos\clientes.sqlite
ACCOUNTS_DB=C:\vm\datos\cuentas.sqlite
EXPORT_DIR=C:\vm\datos\exportaciones
# Aviso por correo de cada pedido (IONOS). Déjalo igual en cliente.env y empresa.env. Sin SMTP_HOST y MAIL_TO no se envía nada.
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
