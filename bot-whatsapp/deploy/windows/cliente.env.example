# Aplicación del CLIENTE (la que se publica en internet). Copia este fichero a C:\vm\config\cliente.env y rellénalo.
APP_MODE=cliente
PORT=3000
# Dirección pública https (la que te dé Tailscale Funnel o Cloudflare Tunnel)
PUBLIC_URL=https://TU-DIRECCION-PUBLICA
TRUST_PROXY=1
# Cadena larga y aleatoria (secreta). Firma los enlaces del pedido.
LINK_SECRET=CAMBIA-ESTO-POR-ALGO-LARGO-Y-ALEATORIO
# Secreto de las huellas del NIF: DEBE ser igual en cliente.env y empresa.env y NO cambiarse nunca después
NIF_PEPPER=CAMBIA-ESTO-POR-OTRA-CADENA-LARGA-Y-FIJA
# Datos (la misma carpeta que en empresa.env)
DB_PATH=C:\vm\datos\pedidos.sqlite
CATALOG_DB=C:\vm\datos\catalogo.sqlite
CUSTOMERS_DB=C:\vm\datos\clientes.sqlite
ACCOUNTS_DB=C:\vm\datos\cuentas.sqlite
IMG_DIR=C:\vm\datos\imagenes\
EXPORT_DIR=C:\vm\datos\exportaciones
# Aviso por correo de cada pedido (IONOS). Déjalo igual en cliente.env y empresa.env. Sin SMTP_HOST y MAIL_TO no se envía nada.
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Información de privacidad que ven los clientes (RGPD). Completa el CIF y un correo de contacto; que lo revise tu gestoría.
PRIVACY_TITULAR=Distribuciones Valentín Martín
PRIVACY_CIF=
PRIVACY_DIRECCION=Medina del Campo (Valladolid)
PRIVACY_EMAIL=

# Entrar SOLO con nombre + NIF + correo + código que llega al correo (usa el mismo correo de salida de arriba: SMTP_HOST, SMTP_USER, SMTP_PASS, MAIL_FROM).
# En cuanto el correo está configurado, es la ÚNICA forma de entrar. Sin correo configurado, esta opción no aparece y todo queda como antes.
# Los clientes sin correo o sin NIF en su ficha no podrán entrar hasta que se lo añadas (Datos y Excel → Clientes → «Ver cambios»).
# CODIGO_CORREO=0 lo apaga todo (vuelve lo de antes). ACCESO_SOLO_CORREO=0 reabre las otras formas de entrar (solo para emergencias).
# ALTA_AUTOMATICA=1 dejaría entrar solos a los que se parezcan a un cliente (NO recomendado: por defecto toda alta la aceptas tú).
#CODIGO_CORREO=1
#ACCESO_SOLO_CORREO=1
