# Copia este archivo a .env y rellena los valores (ver README.md)
PORT=3000

# Una palabra secreta que inventas tú; la pones igual en el panel de Meta
VERIFY_TOKEN=cambia-esto-por-una-palabra-secreta

# Meta for Developers > tu app > WhatsApp > API Setup
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Meta > App settings > Basic > App secret (valida que los mensajes vienen de Meta)
APP_SECRET=

# Base de datos de pedidos (hoja de Google, ver README): URL de la aplicación web y la clave que elijas
SHEET_WEBHOOK_URL=
SHEET_SECRET=

# Opcional: tu número personal (con prefijo, sin +) para recibir avisos de pedidos.
# Solo llegan si tú has escrito al bot en las últimas 24 h (regla de WhatsApp).
OWNER_PHONE=

# Dirección pública (HTTPS) de este servidor: el enlace "Hacer pedido" que recibe el cliente apunta aquí
PUBLIC_URL=https://tu-servidor.example.com
# Clave para firmar los enlaces personales (inventa una larga). Si cambia, los enlaces enviados dejan de valer
LINK_SECRET=

# Base de datos de pedidos (SQLite). Debe estar en un disco persistente
DB_PATH=pedidos.sqlite
# Exportación diaria a Excel: carpeta de salida y hora (hora de Madrid) a partir de la cual se genera
EXPORT_DIR=exportaciones
EXPORT_TIME=21:00
# Copias de seguridad diarias de la base de datos (se conservan las 14 últimas)
BACKUP_DIR=respaldos
# Bases de datos de productos y de clientes (las alimenta el ERP; ver node datos.js)
CATALOG_DB=catalogo.sqlite
CUSTOMERS_DB=clientes.sqlite
# Cuentas de clientes (teléfono + PIN) y clave de la vista del distribuidor
ACCOUNTS_DB=cuentas.sqlite
ADMIN_TOKEN=cambia-esto-por-una-clave-larga
# TRUST_PROXY=1   # si hay un proxy delante (Render, Cloudflare…)
